# Docker Compose Environment Variables
# Copy this file to .env in the project root for Docker Compose to use

# MongoDB Root User Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here
MONGO_DB_NAME=hive_db

# Flask Backend Configuration
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
FLASK_ENV=development

# Generate secure keys with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Note: The backend service in docker-compose.yml will automatically construct
# MONGO_URI from the MongoDB variables above.
